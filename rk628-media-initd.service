[Unit]
Description=RK628 media initialization
Requires=sys-kernel-debug.mount dev-rk628\x2dmedia.device dev-rk628\x2dvideo.device
After=sys-kernel-debug.mount dev-rk628\x2dmedia.device dev-rk628\x2dvideo.device

[Service]
Type=simple
ExecStart=/bin/sh /usr/libexec/rk628/media-initd.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
